  <!-- Windows-only app: drop foreign native runtimes (assimp/glfw x86, linux, osx)
       from the output so builds and published games stay lean. -->
  <Target Name="TrimForeignRuntimes" AfterTargets="Build" Condition="Exists('$(OutputPath)runtimes')">
    <ItemGroup>
      <_ForeignRuntime Include="$([System.IO.Directory]::GetDirectories('$(OutputPath)runtimes'))" Exclude="$([System.IO.Path]::Combine('$(OutputPath)', 'runtimes', 'win-x64'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignRuntime)" Condition="'@(_ForeignRuntime)' != ''" />
  </Target>

