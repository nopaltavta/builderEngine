<Window x:Class="builder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="1080" Height="700" MinWidth="980" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="#FFD4D4D4"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF2A2E3B" />
            <Setter Property="BorderBrush" Value="#FF4A5168" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" />
                            <ContentPresenter Grid.Column="0" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFCCCCCC" />
                            <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#FF232838" BorderBrush="#FF4A5168" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6E3A0F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFCCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2E3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="#FF2A2E3B" BorderBrush="#FF4A5168" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 3.5 8.5 L 7 12 L 12.5 4.5"
                                      Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FFE67E22" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFE67E22" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="#FF2A2E3B"
                                         Stroke="#FF4A5168" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#FFE67E22"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#FFE67E22" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransparentRepeat" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrangeSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Background="Transparent" Padding="0,7">
                            <Grid>
                                <Border Height="4" CornerRadius="2" Background="#FF3A4054"
                                        VerticalAlignment="Center" />
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Style="{StaticResource TransparentRepeat}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Style="{StaticResource TransparentRepeat}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="#FFE67E22" Stroke="White" StrokeThickness="1.5" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FFE67E22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF08A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2E3B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF4A5168" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF343A4E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollArrow" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Height="14"
                                          Command="{x:Static ScrollBar.LineUpCommand}"
                                          Style="{StaticResource DarkScrollArrow}">
                                <Path Data="M 0 4 L 4 0 L 8 4 Z" Fill="#FF9AA0B4" />
                            </RepeatButton>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource TransparentRepeat}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource TransparentRepeat}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF4A5168" CornerRadius="4" Margin="3,1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <RepeatButton Grid.Row="2" Height="14"
                                          Command="{x:Static ScrollBar.LineDownCommand}"
                                          Style="{StaticResource DarkScrollArrow}">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FF9AA0B4" />
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" Background="#FF1B1E27" CornerRadius="8"
            BorderBrush="#FF333A4F" BorderThickness="1">
        <DockPanel>
            <!-- header -->
            <Grid DockPanel.Dock="Top" Height="54" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Builder Engine" Foreground="White" FontWeight="Bold" FontSize="16"
                           VerticalAlignment="Center" Margin="18,0,0,0" />
                <TextBlock Grid.Column="1" Text="|  Settings" Foreground="#FF9AA0B4" FontSize="14"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Grid.Column="3" Content="✕" Margin="0,0,10,0" VerticalAlignment="Center"
                        Style="{StaticResource TitleCloseButton}" ToolTip="Close (Esc)"
                        Click="Close_Click" Cursor="Arrow" />
            </Grid>
            <Grid Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="296" />
                </Grid.ColumnDefinitions>
                <!-- left nav -->
                <StackPanel x:Name="NavPanel" Grid.Column="0" Margin="0,0,10,0">
                    <Button Tag="Window" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconWindow" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Window" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Mode &amp; theme" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Camera" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconCamera" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Camera" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Look &amp; movement" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Viewport" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconViewport" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Viewport" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Visuals &amp; quality" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Editing" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconEditing" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Editing" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Snapping &amp; drags" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Physics" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconPhysics" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Physics" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Gravity &amp; friction" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Player" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconPlayer" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Player" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Character &amp; avatar" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Sound" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconSound" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sound" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Volume &amp; test" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Sky" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconSky" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Sky" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Presets &amp; time" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Tag="Updates" Style="{StaticResource NavButton}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NavIconUpdate" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Updates" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Manifest &amp; checks" Foreground="#FF9AA0B4" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- center content -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <Grid x:Name="PanelWindow" Visibility="Collapsed">
                    <StackPanel>
                        <Border Background="#FF232838" BorderBrush="#FF333A4F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Window" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Mode and theme." Foreground="#FF9AA0B4" FontSize="11" Margin="0,2,0,8" />
                            <RadioButton x:Name="RadioWindowed" Content="Windowed" Style="{StaticResource OrangeRadio}" Checked="WindowMode_Checked" />
                            <TextBlock Text="Normal resizable window." Foreground="#FF888888" FontSize="11" Margin="33,0,0,4" />
                            <RadioButton x:Name="RadioBorderless" Content="Borderless fullscreen" Style="{StaticResource OrangeRadio}" Checked="WindowMode_Checked" />
                            <TextBlock Text="Fills the screen, no title bar. Esc returns to windowed." Foreground="#FF888888" FontSize="11" Margin="33,0,0,0" />
                        </StackPanel>
                        </Border>
                        <Border Background="#FF232838" BorderBrush="#FF333A4F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Theme" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Studio chrome." Foreground="#FF9AA0B4" FontSize="11" Margin="0,2,0,8" />
                            <RadioButton x:Name="RadioDark" Content="Dark" Style="{StaticResource OrangeRadio}" Checked="Theme_Checked" />
                            <RadioButton x:Name="RadioLight" Content="Light" Style="{StaticResource OrangeRadio}" Checked="Theme_Checked" />
                        </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                    <Grid x:Name="PanelCamera" Visibility="Collapsed">
                    <StackPanel>
                        <Border Background="#FF232838" BorderBrush="#FF333A4F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Camera" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Look and movement." Foreground="#FF9AA0B4" FontSize="11" Margin="0,2,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Look sensitivity" VerticalAlignment="Center" Foreground="#FFCCCCCC" />
                                <Slider x:Name="SensitivitySlider" Grid.Column="1" Minimum="0.05" Maximum="0.6" Style="{StaticResource OrangeSlider}" ValueChanged="CameraSlider_Changed" />
                                <TextBlock x:Name="SensitivityValue" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFCCCCCC" FontFamily="Consolas" />
                                <TextBlock Grid.Row="1" Text="Fly speed" VerticalAlignment="Center" Foreground="#FFCCCCCC" />
                                <Slider x:Name="SpeedSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="30" Style="{StaticResource OrangeSlider}" ValueChanged="CameraSlider_Changed" />
                                <TextBlock x:Name="SpeedValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFCCCCCC" FontFamily="Consolas" />
                                <TextBlock Grid.Row="2" Text="Look smoothing" VerticalAlignment="Center" Foreground="#FFCCCCCC" />
                                <Slider x:Name="LookSmoothSlider" Grid.Row="2" Grid.Column="1" Minimum="4" Maximum="30" Style="{StaticResource OrangeSlider}" ValueChanged="CameraSlider_Changed" />
                                <TextBlock x:Name="LookSmoothValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFCCCCCC" FontFamily="Consolas" />
                                <TextBlock Grid.Row="3" Text="Move smoothing" VerticalAlignment="Center" Foreground="#FFCCCCCC" />
                                <Slider x:Name="MoveSmoothSlider" Grid.Row="3" Grid.Column="1" Minimum="2" Maximum="20" Style="{StaticResource OrangeSlider}" ValueChanged="CameraSlider_Changed" />
                                <TextBlock x:Name="MoveSmoothValue" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFCCCCCC" FontFamily="Consolas" />
                                <TextBlock Grid.Row="4" Text="Field of view" VerticalAlignment="Center" Foreground="#FFCCCCCC" />
                                <Slider x:Name="FovSlider" Grid.Row="4" Grid.Column="1" Minimum="30" Maximum="90" Style="{StaticResource OrangeSlider}" ValueChanged="FovSlider_Changed" />
                                <TextBlock x:Name="FovValue" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFCCCCCC" FontFamily="Consolas" />
                                <TextBlock Grid.Row="5" Text="Zoom speed" VerticalAlignment="Center" Foreground="#FFCCCCCC" />
                                <Slider x:Name="ZoomSpeedSlider" Grid.Row="5" Grid.Column="1" Minimum="0.25" Maximum="3" Style="{StaticResource OrangeSlider}" ValueChanged="ZoomSpeedSlider_Changed" />
                                <TextBlock x:Name="ZoomSpeedValue" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" Foreground="#FFCCCCCC" FontFamily="Consolas" />
