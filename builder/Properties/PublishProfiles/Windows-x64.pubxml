<?xml version="1.0" encoding="utf-8"?>
<!--
  Release publish for sharing + auto-update.
  Usage (PowerShell, from the repo root):
    dotnet publish builder/builder.csproj -p:PublishProfile=Windows-x64 -c Release
    Compress-Archive -Path builder/bin/publish/win-x64/* -DestinationPath builder-win-x64-0.1.0.zip
  Then upload the zip to Google Drive (shared as Anyone with the link) and point
  a manifest JSON at it (see MainWindow auto-update docs):
    { "version": "0.1.0",
      "url": "https://drive.google.com/uc?export=download&id=ZIP_FILE_ID",
      "notes": "optional, shown in the update prompt" }
  Upload the manifest too, share it the same way, and paste ITS link into
  the app under Settings > Updates. Keep zips under ~100 MB so Drive serves
  bytes directly instead of a virus-scan page.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
