<Fluent:RibbonWindow x:Class="builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Fluent="urn:fluent-ribbon"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:models="clr-namespace:builder.Models"
        xmlns:local="clr-namespace:builder"
        mc:Ignorable="d"
        Title="builder engine"
        Width="1280" Height="800"
        FontFamily="{StaticResource AppFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" ResizeMode="CanMinimize" WindowStyle="SingleBorderWindow">
    <Fluent:RibbonWindow.Resources>
        <!-- Dark overlay scrollbars everywhere (no arrow buttons, orange while dragging) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#FF1E1E1E" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="0" />
                                <RowDefinition Height="*" />
                                <RowDefinition MaxHeight="0" />
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bd" Background="#FF555555" CornerRadius="4" Margin="2,4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FF777777" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MaxWidth="0" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition MaxWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="Bd" Background="#FF555555" CornerRadius="4" Margin="4,2" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#FF777777" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Rounded editors shared by Explorer + Properties (Segoe, 4px corners) -->
        <Style x:Key="PropTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF3F3F46" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#FFE67E22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PropButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF505058" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6E3A0F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StartLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE67E22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF08A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StartCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AE67E22" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33E67E22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Fluent:RibbonWindow.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="363*"/>
            <ColumnDefinition Width="917*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= RIBBON BAR ================= -->
        <Fluent:Ribbon x:Name="MainRibbon" Grid.ColumnSpan="2" VerticalAlignment="Center">
            <Fluent:Ribbon.Menu>
                <Fluent:Backstage Header="File">
                    <Fluent:BackstageTabControl>
                        <Fluent:BackstageTabItem Header="New">
                            <StackPanel Margin="24" Width="420" HorizontalAlignment="Left">
                                <TextBlock Text="Start over with an empty baseplate." Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="New place" Width="200" HorizontalAlignment="Left" Padding="8,6"
                                        Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                        Click="New_Click" />
                            </StackPanel>
                        </Fluent:BackstageTabItem>
                        <Fluent:BackstageTabItem Header="Open">
                            <StackPanel Margin="24" Width="420" HorizontalAlignment="Left">
                                <TextBlock Text="Open a saved place (.bp file)." Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="Open..." Width="200" HorizontalAlignment="Left" Padding="8,6"
                                        Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                        Click="Open_Click" />
                            </StackPanel>
                        </Fluent:BackstageTabItem>
                        <Fluent:BackstageTabItem Header="Start">
                            <StackPanel Margin="24" Width="420" HorizontalAlignment="Left">
                                <TextBlock Text="Back to the front page (templates, recents)." Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="Getting Started" Width="200" HorizontalAlignment="Left" Padding="8,6"
                                        Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                        Click="StartPage_Click" />
                            </StackPanel>
                        </Fluent:BackstageTabItem>
                        <Fluent:BackstageTabItem Header="Templates">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel Margin="24" Width="460" HorizontalAlignment="Left">
                                    <TextBlock Text="Start from a ready-made scene. Replaces the current place." Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <StackPanel x:Name="TemplateList" />
                                </StackPanel>
                            </ScrollViewer>
                        </Fluent:BackstageTabItem>
                        <Fluent:BackstageTabItem Header="Save">
                            <StackPanel Margin="24" Width="420" HorizontalAlignment="Left">
                                <TextBlock Text="Save the current place (.bp file)." Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="Save (Ctrl+S)" Width="200" HorizontalAlignment="Left" Padding="8,6"
                                        Background="#FFE67E22" Foreground="White" BorderThickness="0"
                                        Click="Save_Click" />
                                <Button Content="Save As..." Width="200" HorizontalAlignment="Left" Padding="8,6" Margin="0,8,0,0"
                                        Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                        Click="SaveAs_Click" />
                            </StackPanel>
                        </Fluent:BackstageTabItem>
                        <Fluent:BackstageTabItem Header="Publish">
                            <StackPanel Margin="24" Width="440" HorizontalAlignment="Left">
                                <TextBlock Text="Bundle this place as a portable game: engine + game.bp + images in one folder that runs anywhere, then a desktop shortcut." Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button Content="Save as .exe" Width="200" HorizontalAlignment="Left" Padding="8,6"
                                        Background="#FFE67E22" Foreground="White" BorderThickness="0"
                                        Click="ExportGame_Click" />
                                <TextBlock Text="Games land in Documents\Builder Games\&lt;place name&gt; (~80 MB, self-contained). Double-click builder.exe inside to play — no install needed." Foreground="#FF888888" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Fluent:BackstageTabItem>
                    </Fluent:BackstageTabControl>
                </Fluent:Backstage>
            </Fluent:Ribbon.Menu>

            <!-- HOME : like Roblox Home tab -->
            <Fluent:RibbonTabItem Header="Home" IsSelected="True">
                <Fluent:RibbonGroupBox Header="Clipboard">
                    <Fluent:Button Header="Cut" ToolTip="Cut selection (Ctrl+X)" SizeDefinition="Middle" Click="Cut_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/cut.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Copy" ToolTip="Copy selection (Ctrl+C)" SizeDefinition="Middle" Click="Copy_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/copy.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Paste" ToolTip="Paste (Ctrl+V)" SizeDefinition="Middle" Click="Paste_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/paste.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Duplicate" ToolTip="Duplicate (Ctrl+D)" SizeDefinition="Middle" Click="Duplicate_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/duplicate.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Tools">
                    <Fluent:ToggleButton Header="Select" ToolTip="Select (Ctrl+1)" SizeDefinition="Large" GroupName="EditTool" Click="Tool_Click">
                        <Fluent:ToggleButton.LargeIcon>
                            <Image Source="Icons/select.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton x:Name="MoveToolToggle" Header="Move" ToolTip="Move (Ctrl+2)" SizeDefinition="Large" GroupName="EditTool" IsChecked="True" Click="Tool_Click">
                        <Fluent:ToggleButton.LargeIcon>
                            <Image Source="Icons/move.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Scale" ToolTip="Scale (Ctrl+3)" SizeDefinition="Large" GroupName="EditTool" Click="Tool_Click">
                        <Fluent:ToggleButton.LargeIcon>
                            <Image Source="Icons/size.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                    <Fluent:ToggleButton Header="Rotate" ToolTip="Rotate (Ctrl+4)" SizeDefinition="Large" GroupName="EditTool" Click="Tool_Click">
                        <Fluent:ToggleButton.LargeIcon>
                            <Image Source="Icons/rotate.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:ToggleButton.LargeIcon>
                    </Fluent:ToggleButton>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Insert">
                    <Fluent:DropDownButton Header="Insert" ToolTip="Insert a part shape" SizeDefinition="Large">
                        <Fluent:DropDownButton.LargeIcon>
                            <Image Source="Icons/insert.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:DropDownButton.LargeIcon>
                        <Fluent:MenuItem Header="Block" Tag="Block" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/insert.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Ball" Tag="Ball" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Cylinder" Tag="Cylinder" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Wedge" Tag="Wedge" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/wedge.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Cone" Tag="Cone" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Torus" Tag="Torus" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Capsule" Tag="Capsule" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Pyramid" Tag="Pyramid" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Corner Wedge" Tag="CornerWedge" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/wedge.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Stairs" Tag="Stairs" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Half Ball" Tag="HalfBall" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/ball.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Hollow Cylinder" Tag="HollowCylinder" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Bowl" ToolTip="Hollow hemisphere shell" Tag="Bowl" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Arch" Tag="Arch" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Hex Prism" Tag="HexPrism" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Truss" ToolTip="Cube frame of beams" Tag="Truss" Click="InsertShape_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="Killbrick" Click="InsertKillbrick_Click">
                            <Fluent:MenuItem.Icon>
                                <Image Source="Icons/object.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                    </Fluent:DropDownButton>
                    <Fluent:Button Header="Spawn" ToolTip="Insert SpawnLocation" SizeDefinition="Large" Click="InsertSpawn_Click">
                        <Fluent:Button.LargeIcon>
                            <Image Source="Icons/capsuleSpawn.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                    <Fluent:Button Header="Killbrick" ToolTip="Insert killbrick (Block, Damage 100)" SizeDefinition="Large" Click="InsertKillbrick_Click">
                        <Fluent:Button.LargeIcon>
                            <Image Source="Icons/object.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.LargeIcon>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Edit">
                    <Fluent:Button x:Name="UndoButton" Header="Undo" ToolTip="Undo (Ctrl+Z)" SizeDefinition="Middle" Click="Undo_Click" IsEnabled="False">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/undo.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button x:Name="RedoButton" Header="Redo" ToolTip="Redo (Ctrl+Y)" SizeDefinition="Middle" Click="Redo_Click" IsEnabled="False">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/redo.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Delete" ToolTip="Delete selection (Del)" SizeDefinition="Middle" Click="Delete_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/delete.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:ToggleButton Header="Anchor" x:Name="AnchorToggleHome" ToolTip="Anchored" SizeDefinition="Middle" IsChecked="False" IsEnabled="False" Click="Anchor_Click">
                        <Fluent:ToggleButton.Icon>
                            <Image Source="Icons/anchor.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:ToggleButton.Icon>
                    </Fluent:ToggleButton>
                    <Fluent:Button x:Name="ColorButtonHome" Header="Color" ToolTip="Part color" SizeDefinition="Middle" Click="ColorMenu_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/color.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Material" x:Name="MaterialButtonHome" ToolTip="Part material" SizeDefinition="Middle" Click="MaterialMenu_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/texture.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Fluent:Button.Icon>
                    </Fluent:Button>
                    <Fluent:Button Header="Decal" ToolTip="Apply decal to selected part" SizeDefinition="Middle" Click="ApplyDecal_Click">
                        <Fluent:Button.Icon>
                            <Image Source="Icons/decal.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
