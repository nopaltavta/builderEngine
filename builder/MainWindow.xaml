        <!-- ================= MAIN STUDIO LAYOUT ================= -->
        <Grid x:Name="EditorView" Grid.Row="1" Background="#FF2D2D30" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="280" MinWidth="180" MaxWidth="420" />
                <ColumnDefinition x:Name="LeftSplitCol" Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="RightSplitCol" Width="5" />
                <ColumnDefinition x:Name="RightCol" Width="300" MinWidth="200" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Explorer -->
            <Grid Grid.Column="0">
                <Border x:Name="ExplorerPanel" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Explorer" Foreground="White" FontWeight="SemiBold" Margin="8,6,8,4" />
                        <Border DockPanel.Dock="Top" Margin="8,0,8,6" Background="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#FF555555" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFE67E22" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <Path Data="M 2.5 6.5 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0 M 9.3 9.3 L 13.5 13.5"
                                      Stroke="#FF888888" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="ExplorerSearch" Background="Transparent" Foreground="White" BorderThickness="0"
                                         CaretBrush="White" VerticalAlignment="Center"
                                         Text="Search" GotFocus="Search_GotFocus" LostFocus="Search_LostFocus" />
                            </DockPanel>
                        </Border>
                        <TreeView x:Name="ExplorerTree" Background="#FF252526" Foreground="#FFD4D4D4" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  SelectedItemChanged="ExplorerTree_Selected">
                            <TreeView.ItemContainerStyle>
                                <!-- Unity-hierarchy rows: full-bleed, blue selection, chevron expander -->
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#FFD4D4D4" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            Padding="0,2" SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleButton x:Name="Exp" Grid.Column="0" Focusable="False" ClickMode="Press"
                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                          Style="{DynamicResource TreeExpander}" />
                                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                        </Grid>
                                                    </Border>
                                                    <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter TargetName="Exp" Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                    <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3E" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FF2D5D8F" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <!-- Default TreeView paints an unfocused selection as black text on light gray.
                                     Override the system brushes (scoped to this TreeView) to keep it dark. -->
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2D5D8F" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF2D5D8F" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2D5D8F" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFFFF" />
                                <!-- Unity-style chevron expander -->
                                <Style x:Key="TreeExpander" TargetType="ToggleButton">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock x:Name="Ch" Text="▸" Foreground="#FF999999" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Ch" Property="Text" Value="▾" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ch" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <HierarchicalDataTemplate DataType="{x:Type models:SceneNode}" ItemsSource="{Binding Children}">
                                    <Border x:Name="NodeRoot" Background="Transparent" Padding="1,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Image x:Name="NodeIcon" Width="16" Height="16" Margin="0,0,5,0"
                                                   Source="{Binding IconPath}" Stretch="Uniform" Visibility="Collapsed"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="EmojiIcon" Text="{Binding Icon}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Border>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasIconPath}" Value="True">
                                            <Setter TargetName="NodeIcon" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="EmojiIcon" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FF3F3F46" />

            <!-- CENTER: viewport + output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="5" />
                    <RowDefinition x:Name="OutputRow" Height="170" MinHeight="80" MaxHeight="400" />
                </Grid.RowDefinitions>

                <!-- View selector bar -->
                <Border x:Name="ViewBar" Grid.Row="0" Background="#FF333337" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
                    <Border.Resources>
                        <!-- Dark ComboBox renderer (box + drop-down), scoped to this bar so the
                             Fluent ribbon theming is untouched. -->
                        <Style x:Key="DarkComboBox" TargetType="ComboBox">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="#FF3F3F46" />
                            <Setter Property="BorderBrush" Value="#FF555555" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                        <Border x:Name="Box" Grid.ColumnSpan="2"
                                                 Background="{TemplateBinding Background}"
                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                 BorderThickness="1" CornerRadius="0" />
                                            <ContentPresenter Grid.Column="0" Margin="6,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFCCCCCC" />
                                            <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                                                          Focusable="False" ClickMode="Press"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <Popup x:Name="Popup" Placement="Bottom"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                <Border Background="#FF252526" BorderBrush="#FF555555" BorderThickness="1"
                                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                                    <ScrollViewer SnapsToDevicePixels="True">
                                                        <StackPanel IsItemsHost="True" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFE67E22" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#FF888888" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF6E3A0F" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal" Margin="6,4">
                        <TextBlock Text="Place:" VerticalAlignment="Center" Foreground="#FFCCCCCC" Margin="0,0,6,0" />
                        <ComboBox x:Name="PlaceBox" Width="180" Height="24" SelectedIndex="0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                            <ComboBoxItem>Baseplate</ComboBoxItem>
                            <ComboBoxItem>Obby</ComboBoxItem>
                            <ComboBoxItem>Empty</ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="SnapCheck" Foreground="#FFCCCCCC" ToolTip="Snap moves to the snap step"
                                  VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True" Click="SnapCheck_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Icons/snap.png" Width="14" Height="14" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Snap:" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <TextBox x:Name="SnapBox" Width="44" Height="22" Margin="4,0,0,0" Padding="0"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="#FF3F3F46" Foreground="White" BorderThickness="1" BorderBrush="#FF555555"
                                 FontFamily="Consolas" Text="0.5" ToolTip="Snap step in studs (e.g. 0.5). Enter commits."
                                 LostFocus="SnapBox_Commit" KeyDown="SnapBox_KeyDown" />
                    </StackPanel>
                </Border>

                <!-- 3D viewport -->
                <Border Grid.Row="1" Background="#FF1E1E1E">
                    <Grid>
                        <glWpfControl:GLWpfControl x:Name="ViewportControl" Render="Viewport_Render"
                                                         AllowDrop="True" Drop="ViewportControl_Drop" DragOver="ViewportControl_DragOver" DragLeave="ViewportControl_DragLeave">
                            <glWpfControl:GLWpfControl.Settings>
                                <glWpfControl:GLWpfControlSettings MajorVersion="4" MinorVersion="6" RenderContinuously="False" />
                            </glWpfControl:GLWpfControl.Settings>
                        </glWpfControl:GLWpfControl>
                        <!-- overlay: crisp WPF text over OpenGL (no airspace issues with GLWpfControl) -->
                        <Border x:Name="ViewportInfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Background="#AA000000" CornerRadius="4" Padding="8,4">
                            <StackPanel>
                                <TextBlock x:Name="ViewportTitle" Text="Viewport" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock x:Name="ToolLabel" Text="Tool: Move" Foreground="#FFCCCCCC" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <!-- damage vignette: red edges over the GL view, flashes on hit -->
                        <Border x:Name="DamageVignette" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                                    <GradientStop Offset="0.55" Color="#00FF0000" />
                                    <GradientStop Offset="1" Color="#99FF0000" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- NPC speech bubbles: WPF overlay positioned over each chatting NPC -->
                        <Canvas x:Name="NpcBubbleLayer" IsHitTestVisible="False" ClipToBounds="True" />
                        <!-- marquee select: drag box on empty viewport space -->
                        <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" IsHitTestVisible="False"
                                   Stroke="#FFE67E22" StrokeThickness="1" StrokeDashArray="4 2"
                                   Fill="#22E67E22" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Height="0" />
                        <!-- healthbar: compact, top-right, only while hurt in play mode -->
                        <Border x:Name="HealthBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                Background="#AA000000" CornerRadius="4" Padding="6,4" Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="❤" Foreground="#FFFF5555" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Width="140" Height="10" Background="#FF3F3F46" CornerRadius="5" ClipToBounds="True">
                                    <Border x:Name="HealthFill" HorizontalAlignment="Left" Width="140" Height="10"
                                            Background="#FF33CC66" CornerRadius="5" />
                                </Border>
                                <TextBlock x:Name="HealthText" Text="100" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="6,0,0,0" Width="26" />
                            </StackPanel>
                        </Border>
                        <!-- pause menu (player mode only): blocks viewport input while up -->
                        <Border x:Name="PauseMenu" Visibility="Collapsed" Background="#AA000000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                                <TextBlock Text="Paused" Foreground="White" FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock x:Name="PauseGameName" Text="" Foreground="#FFCCCCCC"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="WASD move · Space jump · Esc pause" Foreground="#FF888888" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <Button Content="Resume" Padding="8,6" Margin="0,0,0,8"
                                        Background="#FFE67E22" Foreground="White" BorderThickness="0"
                                        Click="Resume_Click" />
                                <Button Content="Settings" Padding="8,6" Margin="0,0,0,8"
                                        Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                        Click="GameSettings_Click" />
                                <Button Content="Quit to Desktop" Padding="8,6"
                                        Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                        Click="Quit_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <GridSplitter x:Name="OutputSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#FF3F3F46" />

                <!-- Output -->
                <Border x:Name="OutputPanel" Grid.Row="3" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TabControl Background="#FF252526" Foreground="White" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Foreground" Value="#FFCCCCCC" />
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="Bd" Background="#FF2D2D30" BorderBrush="#FF3F3F46"
                                                        BorderThickness="1,1,1,0" CornerRadius="3,3,0,0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter ContentSource="Header"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FF1E1E1E" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>
                            <TabItem Header="Output">
                                <TextBox x:Name="OutputBox" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                                         FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap" Text="builder engine ready.&#xA;OpenTK viewport initialized.&#xA;" />
                            </TabItem>
                            <TabItem Header="Problems">
                                <TextBlock Text="No problems." Foreground="#FF888888" Margin="8" />
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter x:Name="PropertiesSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#FF3F3F46" />

            <!-- RIGHT: Toolbox (top) + Properties (bottom) -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ToolboxRow" Height="*" MinHeight="150" />
                    <RowDefinition x:Name="SplitBRow" Height="5" />
                    <RowDefinition x:Name="PropsRow" Height="1.5*" MinHeight="180" />
                </Grid.RowDefinitions>
                <Border x:Name="ToolboxPanel" Grid.Row="0" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
                    <local:ToolboxPanel x:Name="ToolboxTabs" />
                </Border>
                <GridSplitter x:Name="ToolboxSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FF3F3F46" />
                <Border x:Name="PropertiesPanel" Grid.Row="2" Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0">
                <Border.Resources>
                    <!-- Dark sliders + checkboxes, scoped to this panel -->
                    <Style TargetType="Slider">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Slider">
                                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                                        <Border Height="4" CornerRadius="2" Background="#FF3F3F46" Margin="6,0" />
                                        <Track x:Name="PART_Track" Focusable="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Width="12" Height="16" Focusable="False">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="Bd" Background="#FF888888" CornerRadius="3" BorderThickness="0" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#FFAAAAAA" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="#FFCCCCCC" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="0"
                                                Background="#FF3F3F46" BorderBrush="#FF555555" BorderThickness="1">
                                            <Path x:Name="Check" Data="M 3.5 8 L 6.5 11 L 11.5 4" Stroke="White"
                                                  StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="Collapsed" />
                                        </Border>
                                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Box" Property="Background" Value="#FFE67E22" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFE67E22" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#FF999999" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>                    <Style x:Key="PropDarkCombo" TargetType="ComboBox">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="#FF3F3F46" />
                        <Setter Property="BorderBrush" Value="#FF555555" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Box" Grid.ColumnSpan="2"
                                                 Background="{TemplateBinding Background}"
                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                 BorderThickness="1" CornerRadius="0" />
                                        <ContentPresenter Grid.Column="0" Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFCCCCCC" />
                                        <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                                                      Focusable="False" ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Popup x:Name="Popup" Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                            <Border Background="#FF252526" BorderBrush="#FF555555" BorderThickness="1"
                                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                                <ScrollViewer SnapsToDevicePixels="True">
                                                    <StackPanel IsItemsHost="True" />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFE67E22" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#FF888888" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="PropSectionButton" TargetType="Button">
                        <Setter Property="Background" Value="#FF2D2D30" />
                        <Setter Property="BorderBrush" Value="#FF333336" />
                        <Setter Property="BorderThickness" Value="0,1,0,1" />
                        <Setter Property="Padding" Value="8,6,8,5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF383838" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF262626" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="PropDarkComboItem" TargetType="ComboBoxItem">                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF6E3A0F" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Properties" Foreground="White" FontWeight="SemiBold" Margin="8,6,8,4" />
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,8,0" x:Name="InspectorHeader" LastChildFill="True">
                        <Image x:Name="InspectorIcon" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBox x:Name="InspectorName" VerticalAlignment="Center" Background="Transparent" Foreground="White"
                                 FontWeight="SemiBold" FontSize="13" BorderThickness="0" Padding="2,0"
                                 LostFocus="InspectorName_Commit" KeyDown="InspectorName_KeyDown" GotFocus="InspectorName_GotFocus"
                                 ToolTip="Object name. Enter commits." />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="SelectedLabel" Text="Baseplate" Foreground="#FF777777" Margin="30,0,8,4" FontSize="11" Visibility="Collapsed" />
                     <TextBox DockPanel.Dock="Top" x:Name="PropertiesFilter" Margin="8,0,8,6" Height="24" Visibility="Collapsed"
                              Style="{StaticResource PropTextBox}"
                              Text="Search" GotFocus="Search_GotFocus" LostFocus="Search_LostFocus" TextChanged="PropertiesFilter_Changed"
                              ToolTip="Filter properties by name, category or value" />
                    <TextBlock DockPanel.Dock="Bottom" x:Name="PropHint" Text="Enter commits · Esc reverts" Foreground="#FF777777" FontSize="10" Margin="8,4,8,6" />
                    <Button DockPanel.Dock="Bottom" x:Name="AddComponentButton" Content="Add Component" Margin="8,0,8,4" Padding="0,5"
                            Style="{StaticResource PropButton}" Click="AddComponent_Click">
                        <Button.ContextMenu>
                            <ContextMenu Background="#FF252526" Foreground="White">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                        <ContentPresenter ContentSource="Header" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFE67E22" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="Decal" Tag="Add decal" Click="AddComponentItem_Click" />
                                <MenuItem Header="Text" Tag="Add text" Click="AddComponentItem_Click" />
                                <MenuItem Header="Sound" Tag="Add sound" Click="AddComponentItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ListBox x:Name="PropertiesList" Background="#FF252526" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button x:Name="Category" Style="{StaticResource PropSectionButton}"
                                            Visibility="Collapsed" Click="CategoryToggle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CatChevron}" Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Category}" Foreground="#FFD4D4D4" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Grid x:Name="Editor" Margin="8,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#FFB8B8B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                        <!-- default text -->
                                        <TextBox x:Name="TextEditor" Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 LostFocus="PropertyText_LostFocus" KeyDown="PropertyText_KeyDown"
                                                 Style="{StaticResource PropTextBox}" ToolTip="{Binding Description}" />
                                        <!-- read-only -->
                                        <TextBlock x:Name="ReadOnlyText" Grid.Column="1" Text="{Binding Value}" Foreground="#FF777777" FontStyle="Italic"
                                                   VerticalAlignment="Center" Padding="4,2" Visibility="Collapsed" ToolTip="{Binding Description}" />
                                        <!-- bool -->
                                        <CheckBox x:Name="BoolEditor" Grid.Column="1" IsChecked="{Binding BooleanValue}" Click="PropertyBoolean_Click" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="{Binding Description}" />
                                        <!-- enum / choice -->
                                        <ComboBox x:Name="ChoiceEditor" Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                                  SelectionChanged="PropertyChoice_SelectionChanged" Visibility="Collapsed"
                                                  Style="{StaticResource PropDarkCombo}" ItemContainerStyle="{StaticResource PropDarkComboItem}" ToolTip="{Binding Description}" />
                                        <!-- color: swatch + rgb/hex -->
                                        <DockPanel x:Name="ColorPanel" Grid.Column="1" Visibility="Collapsed" LastChildFill="True">
                                            <Border Width="22" Height="22" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="0"
                                                    Background="{Binding Swatch}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    MouseLeftButtonDown="PropertySwatch_Click" Cursor="Hand" ToolTip="Open color picker" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="PropertyText_LostFocus" KeyDown="PropertyText_KeyDown"
                                                     Style="{StaticResource PropTextBox}" ToolTip="{Binding Description}" />
                                        </DockPanel>
                                        <!-- number 0-1: slider + value -->
                                        <DockPanel x:Name="NumberPanel" Grid.Column="1" Visibility="Collapsed" LastChildFill="True">
                                            <TextBox DockPanel.Dock="Right" Width="58" Margin="6,0,0,0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     LostFocus="PropertyText_LostFocus" KeyDown="PropertyText_KeyDown"
                                                     Style="{StaticResource PropTextBox}" ToolTip="{Binding Description}" />
                                            <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                                    Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ValueChanged="PropertySlider_Changed" VerticalAlignment="Center" ToolTip="{Binding Description}" />
                                        </DockPanel>
                                        <!-- action: add / remove buttons -->
                                        <Button x:Name="ActionButton" Grid.Column="1" Content="{Binding Value}" Click="PropertyAction_Click"
                                                Style="{StaticResource PropButton}"
                                                Visibility="Collapsed" ToolTip="{Binding Description}" />
                                        <!-- file / image: thumbnail + name + browse -->
                                        <DockPanel x:Name="FilePanel" Grid.Column="1" Visibility="Collapsed" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="6,0,0,0" Click="PropertyImage_Click"
                                                    Style="{StaticResource PropButton}" ToolTip="Browse image…" />
                                            <Border Width="26" Height="26" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="0" Background="#FF1E1E1E"
                                                    Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding ShortValue}" Foreground="#FFD4D4D4" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" FontSize="11" />
                                        </DockPanel>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowCategory}" Value="True"><Setter TargetName="Category" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding HideEditor}" Value="True"><Setter TargetName="Editor" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="BoolEditor" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="ChoiceEditor" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsColor}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="ColorPanel" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsNumber}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="NumberPanel" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsFile}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsAction}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="ActionButton" Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/><Setter TargetName="ReadOnlyText" Property="Visibility" Value="Visible"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ================= GETTING STARTED (blocking front page) ================= -->
        <ScrollViewer x:Name="GettingStartedView" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                      Background="#FF1E1E1E" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Panel.ZIndex="100">
            <StackPanel Margin="48,30,48,30" MaxWidth="960" HorizontalAlignment="Left">
                <TextBlock Text="Builder Engine" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Button Content="Create new project" Style="{StaticResource StartLink}" Click="StartNew_Click" />
                <Button Content="Open existing project" Style="{StaticResource StartLink}" Click="StartOpen_Click" />
                <TextBlock Text="Templates" Foreground="White" FontWeight="SemiBold" FontSize="16" Margin="0,26,0,10" />
                <WrapPanel x:Name="StartTemplateCards" Orientation="Horizontal" />
                <TextBlock Text="Recent places" Foreground="White" FontWeight="SemiBold" FontSize="16" Margin="0,26,0,10" />
                <StackPanel x:Name="StartRecentList" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= STATUS BAR ================= -->
        <StatusBar x:Name="StatusBar" Grid.Row="2" Background="#FFE67E22" Foreground="White" Height="24" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="PartsText" Text="6 objects" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="SelText" Text="Nothing selected" FontFamily="Consolas" FontSize="11" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FpsText" Text="60 FPS · 0.0ms" FontFamily="Consolas" FontSize="11" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CamText" Text="Pos 0.0,1.5,8.0 yaw -90° pitch -10°" FontFamily="Consolas" FontSize="11" />
            </StatusBarItem>
        </StatusBar>

        <!-- ================= COLOR MENU ================= -->
        <Popup x:Name="ColorPopup"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               Closed="ColorPopup_Closed">
            <Border Width="396" Background="#FF252526" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="Part color" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <UniformGrid x:Name="SwatchGrid" Columns="7" />
                    <Rectangle Height="1" Fill="#FF3F3F46" Margin="0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Canvas x:Name="SVCanvas" Width="200" Height="200"
                                MouseLeftButtonDown="SV_Down" MouseMove="SV_Move" MouseLeftButtonUp="SV_Up"
                                Background="Transparent" Cursor="Cross">
                            <Image x:Name="SVImage" Width="200" Height="200" />
                            <Line x:Name="SVLineH" X1="0" X2="200" Y1="0" Y2="0" Stroke="White" StrokeThickness="1" Opacity="0.65" />
                            <Line x:Name="SVLineV" X1="0" X2="0" Y1="0" Y2="200" Stroke="White" StrokeThickness="1" Opacity="0.65" />
                            <Ellipse x:Name="SVMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent" />
                        </Canvas>
                        <StackPanel x:Name="ModeButtons" Margin="8,0,0,0" Width="28" VerticalAlignment="Center">
                            <Button Content="R" Tag="R" Height="30" Margin="0,0,0,4" Click="ColorMode_Click" />
                            <Button Content="G" Tag="G" Height="30" Margin="0,0,0,4" Click="ColorMode_Click" />
                            <Button Content="B" Tag="B" Height="30" Margin="0,0,0,4" Click="ColorMode_Click" />
                            <Button Content="H" Tag="H" Height="30" Margin="0,0,0,4" Click="ColorMode_Click" />
                            <Button Content="S" Tag="S" Height="30" Margin="0,0,0,4" Click="ColorMode_Click" />
                            <Button Content="V" Tag="V" Height="30" Click="ColorMode_Click" />
                        </StackPanel>
                        <Canvas x:Name="HueCanvas" Width="22" Height="200" Margin="6,0,0,0"
                                MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up"
                                Background="Transparent" Cursor="Cross">
                            <Image x:Name="HueImage" Width="22" Height="200" />
                            <Rectangle x:Name="HueMarker" Width="22" Height="4" Stroke="White" StrokeThickness="1.5" Fill="Transparent" />
                        </Canvas>
                        <StackPanel Margin="8,0,0,0" Width="100" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                    <TextBlock Text="Was" Foreground="#FF999999" FontSize="10" HorizontalAlignment="Center" />
                                    <Border x:Name="CurrentPreview" Height="26" Background="Blue"
                                            BorderBrush="#FF555555" BorderThickness="1" CornerRadius="4" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <TextBlock Text="New" Foreground="#FFCCCCCC" FontSize="10" HorizontalAlignment="Center" />
                                    <Border x:Name="NewPreview" Height="26" Background="Blue"
                                            BorderBrush="#FFAAAAAA" BorderThickness="1" CornerRadius="4" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="RgbBox" Height="24" Margin="0,10,0,0"
                                     VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                                     Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555" BorderThickness="1"
                                     MaxLength="15" ToolTip="Hex (183229) or r, g, b"
                                     LostFocus="RgbBox_Commit" KeyDown="RgbBox_KeyDown" />
                            <Button Content="Apply" Margin="0,8,0,0" Padding="0,4"
                                    Click="ApplyCustom_Click" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="RecentLabel" Text="History" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <UniformGrid x:Name="RecentGrid" Columns="10" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= MATERIAL MENU ================= -->
        <Popup x:Name="MaterialPopup" PlacementTarget="{Binding ElementName=MaterialButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="250" Background="#FF252526" BorderBrush="#FF555555" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="Part material" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel x:Name="MaterialList" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Fluent:RibbonWindow>
